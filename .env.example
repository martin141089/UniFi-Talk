# TalkAnchor-Konfiguration über Umgebungsvariablen.
# Nach `.env` kopieren und eigene Werte eintragen — die echte Datei niemals committen.
# Äquivalent zu config.yaml; Umgebungsvariablen gewinnen immer, wenn beides vorhanden ist.
# Verschachtelte Felder nutzen einen doppelten Unterstrich, z. B. TALKANCHOR_CLOUDFLARE__API_TOKEN.

# --- Sicherheit -----------------------------------------------------------
# Aktiviert lassen, bis ein kompletter Dry-Run-Zyklus end-to-end geprüft wurde.
TALKANCHOR_DRY_RUN=true

TALKANCHOR_POLL_INTERVAL_SECONDS=300
TALKANCHOR_MIN_SECONDS_BETWEEN_CHANGES=300
TALKANCHOR_DATA_DIR=./data

# --- Cloudflare-Tunnel-Quelle ----------------------------------------------
# Token-Scope: Account -> Cloudflare Tunnel -> Read (minimaler Nur-Lese-Scope).
TALKANCHOR_CLOUDFLARE__API_TOKEN=
TALKANCHOR_CLOUDFLARE__ACCOUNT_ID=
TALKANCHOR_CLOUDFLARE__TUNNEL_ID=

# --- Fallback-HTTP-Echo-Quelle ----------------------------------------------
TALKANCHOR_HTTP_ECHO__URL=https://api.ipify.org?format=json
TALKANCHOR_HTTP_ECHO__JSON_FIELD=ip

# --- UniFi-Talk-SSH-Ziel ----------------------------------------------------
# Nur Key-Auth. Es gibt absichtlich kein Passwort-Feld.
TALKANCHOR_UNIFI_TALK__HOST=
TALKANCHOR_UNIFI_TALK__SSH_PORT=22
TALKANCHOR_UNIFI_TALK__SSH_USER=root
TALKANCHOR_UNIFI_TALK__SSH_KEY_PATH=~/.ssh/id_ed25519
TALKANCHOR_UNIFI_TALK__SOFIA_PROFILE=external_talk
TALKANCHOR_UNIFI_TALK__CONFIG_PATH=
TALKANCHOR_UNIFI_TALK__BACKUP_DIR_REMOTE=/root/talkanchor-backups
TALKANCHOR_UNIFI_TALK__HEALTH_CHECK_TIMEOUT_SECONDS=30

# --- Benachrichtigungen (einen Kanal wählen: ntfy | webhook | email | none) -
TALKANCHOR_NOTIFY__CHANNEL=none
TALKANCHOR_NOTIFY__NTFY_TOPIC_URL=
TALKANCHOR_NOTIFY__WEBHOOK_URL=
TALKANCHOR_NOTIFY__EMAIL_TO=
TALKANCHOR_NOTIFY__EMAIL_SMTP_HOST=
TALKANCHOR_NOTIFY__EMAIL_SMTP_PORT=587
TALKANCHOR_NOTIFY__EMAIL_SMTP_USER=
TALKANCHOR_NOTIFY__EMAIL_SMTP_PASSWORD=

# --- Dashboard ---------------------------------------------------------------
TALKANCHOR_WEB_HOST=0.0.0.0
TALKANCHOR_WEB_PORT=8420
